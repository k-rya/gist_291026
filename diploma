import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import solve_ivp
from scipy.stats import norm


N = 50
K = 2.0
K_1 = 1.0

omega = norm.rvs(loc=0, scale=1, size=N)


theta0 = np.random.uniform(0, 2*np.pi, N)


def kuramoto(t, theta):
    dtheta_dt = np.zeros_like(theta)
    for i in range(N):

        pair_term = np.sum(np.sin(theta - theta[i]))


        triple_term = 0
        for j in range(N):
            for k in range(N):
                triple_term += np.sin(theta[j] + theta[k] - 2*theta[i])

        dtheta_dt[i] = omega[i] + K/N * pair_term + K_1/(N**2) * triple_term
    return dtheta_dt

t_span = [0, 50]
sol = solve_ivp(kuramoto, t_span, theta0, method='RK45', t_eval=np.linspace(0, 50, 100000))


plt.figure(figsize=(10, 6))


plt.subplot(2, 1, 1)
for i in range(N):
    plt.plot(sol.t, np.sin(sol.y[i]), alpha=0.5)
plt.title('Динамика фаз осцилляторов')
plt.xlabel('Время')
plt.ylabel('sin(θ)')


plt.tight_layout()
plt.show()
import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import odeint
from scipy.stats import norm
import lyapynov


N = 250
T = 1000
steps = 100000
t = np.linspace(0, T, steps)
dt = t[1] - t[0]


np.random.seed(42)
omega = norm.rvs(loc=0, scale=1, size=N)
initial_phases = np.random.uniform(0, 2*np.pi, N)


def kuramoto(theta, t, K, N, omega):
    theta_i = theta[:, np.newaxis]
    theta_j = theta[np.newaxis, :]
    return omega + (K/N) * np.sum(np.sin(theta_j - theta_i), axis=1)


def jacobian(theta, t, K, N, omega):
    theta_i = theta[:, np.newaxis]
    theta_j = theta[np.newaxis, :]
    J = (K/N) * np.cos(theta_j - theta_i)
    np.fill_diagonal(J, -np.sum(J, axis=1))
    return J


def order_parameter(theta):
    return np.abs(np.mean(np.exp(1j * theta)))


K_values = np.linspace(0, 5, 30)
order_params = []
lyapunovs = []

for K in K_values:

    sol = odeint(kuramoto, initial_phases, t, args=(K, N, omega))

    steady_state = sol[-int(0.1*len(sol)):]
    r = np.mean([order_parameter(phi) for phi in steady_state])
    order_params.append(r)


    system = lyapynov.ContinuousDS(
        initial_phases,
        0,
        lambda x, t: kuramoto(x, t, K, N, omega),
        lambda x, t: jacobian(x, t, K, N, omega),
        dt
    )


    lyapynov.mLCE(system, n_forward=1000, n_compute=100, keep=False)


    exponents, _ = lyapynov.LCE(system, p=N, n_forward=0, n_compute=1000, keep=True)
    lyapunovs.append(np.max(exponents))


plt.figure(figsize=(14, 6))


plt.subplot(1, 2, 1)
plt.plot(K_values, order_params, 'r-', lw=2)
plt.xlabel('Коэффициент связи K', fontsize=12)
plt.ylabel('Параметр порядка r', fontsize=12)
plt.title('Зависимость параметра порядка от K', fontsize=14)
plt.grid(True, alpha=0.5)
plt.ylim(0, 1.05)


plt.subplot(1, 2, 2)
plt.plot(K_values, lyapunovs, 'b-', lw=2)
plt.axhline(0, color='gray', ls='--')
plt.xlabel('Коэффициент связи K', fontsize=12)
plt.ylabel('λ (старший показатель Ляпунова)', fontsize=12)
plt.title('Зависимость λ от K', fontsize=14)
plt.grid(True, alpha=0.5)

plt.tight_layout()
plt.show()
import numpy as np
