    for j in range(len(K2_grid)):
        K1 = K1_grid[i]
        K2 = K2_grid[j]


        sol = odeint(kuramoto_2nd_order, initial_phases, t, args=(K1, K2, N, omega))


        steady_state = sol[-int(0.1*len(sol)):]
        r = np.mean([order_parameter(phi) for phi in steady_state])
        r_matrix[j, i] = r


        system = lyapynov.ContinuousDS(
            initial_phases,
            0,
            lambda x, t: kuramoto_2nd_order(x, t, K1, K2, N, omega),
            lambda x, t: jacobian_2nd_order(x, t, K1, K2, N, omega),
            dt
        )
        lyapynov.mLCE(system, n_forward=1000, n_compute=500, keep=False)
        exponents, _ = lyapynov.LCE(system, p=N, n_forward=0, n_compute=1000, keep=True)
        lambda_matrix[j, i] = np.max(exponents)


plt.figure(figsize=(18, 6))


plt.subplot(1, 2, 1)
contour = plt.contourf(K1_mesh, K2_mesh, r_matrix, levels=20, cmap='viridis')
